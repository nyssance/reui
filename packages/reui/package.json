{
  "name": "@nyssance/reui",
  "version": "2.8.1",
  "description": "MIT ReUI Base UI Vega primitives, packaged as ESM with TypeScript declarations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyssance/reui.git",
    "directory": "packages/reui"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "REUI-LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "registry.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "react": "^19.3",
    "react-dom": "^19.3",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headless-tree/core": "^1.8.0",
    "@nyssance/shadcn": "^4.23.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": ">=3.14.25 <3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66",
    "react-day-picker": "^10.0.2",
    "react-phone-number-input": "^3.4.18",
    "shiki": "^4.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
